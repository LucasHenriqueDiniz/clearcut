# Node
frontend/node_modules
frontend/dist
frontend/tsconfig.tsbuildinfo
# Stale, unused: this project installs with npm (package-lock.json).
frontend/pnpm-lock.yaml

# Python
backend/.venv
backend/__pycache__
backend/**/*.pyc

# Runtime data
backend/data/*.db
backend/data/providers.json
backend/logs/*
backend/models/*
# The backend resolves its data dirs relative to the working directory, so
# launching it from the repo root creates these at the top level instead.
# They hold databases, downloaded models and provider settings - never commit them.
/data/
/logs/
/models/
/outputs/
/uploads/
backend/uploads/*
backend/outputs/*
!backend/outputs/.gitkeep
runtime/backend/data/*
runtime/backend/uploads/*
runtime/backend/outputs/*
runtime/backend/models/*
!runtime/.gitkeep
src-tauri/target
src-tauri/resources/backend/*
!src-tauri/resources/backend/.gitkeep
.build
.frontend-node_modules-backup
frontend/.git.bak

# Env
.env
backend/.env
frontend/.env.local

# OS
.DS_Store
Thumbs.db
